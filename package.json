{
  "name": "kospi-screener",
  "description": "코스피 종목 분석 — 코스피 전 종목 조건검색 + 원하는 종목 종가 분석/보고서/엑셀",
  "license": "MIT",
  "author": "최미경 (Choi Mi-kyung)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "snapshot": "node scripts/fetch-snapshot.mjs",
    "snapshot:test": "node scripts/fetch-snapshot.mjs --limit 30",
    "prices": "node scripts/fetch-prices.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
